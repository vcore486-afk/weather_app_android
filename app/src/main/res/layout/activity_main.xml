                android:id="@+id/samara_temp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="..."
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Омск"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/omsk_temp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="..."
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Токио"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tokyo_temp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="..."
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Нью-Йорк"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/ny_temp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="..."
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Рим"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/roma_temp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="..."
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
